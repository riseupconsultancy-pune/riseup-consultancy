generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         String    @default("HR_RECRUITER") // SUPER_ADMIN, HR_RECRUITER, CLIENT
  status       String    @default("ACTIVE")       // ACTIVE, INACTIVE
  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clientProfile     ClientProfile?
  hrProfile         HrProfile?
  createdAgreements ClientAgreement[]        @relation("AdminAgreements")
  statusChanges     CandidateStatusHistory[]
}

model ClientProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  country       String   @default("India")
  city          String
  industry      String?  @default("BPO / BPM")
  contactPerson String?
  phone         String?
  billingAddress       String?  @db.Text
  billingGstin         String?
  billingPan           String?
  billingContactPerson String?
  billingEmail         String?
  billingPhone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vacancies  Vacancy[]
  agreements ClientAgreement[]
  invoices   Invoice[]
}

model HrProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String   @unique
  commissionRate   Float?   @default(0.0)
  whatsappTemplate String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  publicLinks       HrPublicLink[]
  sourcedCandidates Candidate[]
}

model Vacancy {
  id                   String    @id @default(uuid())
  jobId                String    @unique // Formatted: RUP-JOB-1001
  title                String
  category             String    // Voice, Non-Voice, Back Office, BPM, IT Software, IT Support
  clientId             String
  client               ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  country              String    @default("India")
  city                 String
  expMin               Int       @default(0)
  expMax               Int       @default(5)
  workMode             String    @default("On-site") // On-site, Hybrid, Remote
  shift                String?   @default("Day Shift")
  salaryMin            Float?
  salaryMax            Float?
  salaryCurrency       String    @default("INR")
  headcount            Int       @default(1)
  availabilityRequired String    @default("Immediate Joiner") // Immediate Joiner, 15 Days, 30 Days
  description          String    @db.Text
  requirements         String?   @db.Text
  interviewVenue         String?   @db.Text // Physical interview venue / building / landmark
  interviewLocationUrl   String?   @db.Text // Google Maps navigation URL
  interviewContactPerson String?   // Reception / On-site HR SPOC
  interviewContactPhone  String?   // Contact phone to call upon arrival
  interviewInstructions  String?   @db.Text // Candidate instructions (e.g. CV copies, dress code)
  status               String    @default("PENDING_REVIEW") // PENDING_REVIEW, ACTIVE, FULFILLED, CLOSED, DISABLED
  isBroadcastedToHR    Boolean   @default(false)
  isPostedOnWebsite    Boolean   @default(false)
  broadcastedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  hrLinks    HrPublicLink[]
  candidates Candidate[]
}

model HrPublicLink {
  id         String   @id @default(uuid())
  uniqueSlug String   @unique // e.g. job-rup-1001-hr101
  hrId       String
  hr         HrProfile @relation(fields: [hrId], references: [id], onDelete: Cascade)
  vacancyId  String
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  status     String   @default("ACTIVE") // ACTIVE, DISABLED
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  candidates Candidate[]
}

model Candidate {
  id              String    @id @default(uuid())
  candidateId     String    @unique // Formatted: RUP-CAN-1001
  fullName        String
  email           String
  phone           String
  country         String    @default("India")
  city            String
  qualification   String
  totalExperience String    @default("Fresher")
  availability    String    @default("Immediate Joiner") // Immediate Joiner, 15 Days, 30 Days
  interestedRoles String    @db.Text // JSON Array: ["Voice", "Non-Voice", "Back Office"]
  resumeUrl       String    // /uploads/resumes/uuid.pdf
  resumeFileName  String
  resumeFileSize  Int
  source          String    @default("HR_LINK") // HR_LINK, WEBSITE_CARD
  vacancyId       String
  vacancy         Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  hrId            String?
  hr              HrProfile? @relation(fields: [hrId], references: [id], onDelete: SetNull)
  hrPublicLinkId  String?
  hrPublicLink    HrPublicLink? @relation(fields: [hrPublicLinkId], references: [id], onDelete: SetNull)
  referralTag     String?   // e.g. "Referral: Priya Sharma | RiseUp Consultancy"
  status          String    @default("APPLIED") // APPLIED, CONNECTED, GOING_FOR_INTERVIEW, INTERVIEWED, SELECTED, REJECTED, ABSENT
  clientFeedback  String?   @db.Text
  interviewDate   DateTime?
  selectedAt      DateTime?
  placementFee    Float?
  commissionAmount Float?

  // Billing & Invoicing Fields
  empId           String?   // Client Employee ID, e.g., 1520417
  process         String?   // Process / Team, e.g., TCS GEM, Meesho
  designation     String?   // Role Designation, e.g., Tele sales Executive
  dateOfJoining   DateTime? // DOJ
  billingAmount   Float?    // Invoiced Amount (₹)
  billingInfoStatus String  @default("PENDING_INFO") // PENDING_INFO, INFO_SUBMITTED, INVOICED
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  statusHistory CandidateStatusHistory[]
}

model CandidateStatusHistory {
  id              String    @id @default(uuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  previousStatus  String?
  newStatus       String
  changedByUserId String?
  changedByUser   User?     @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByRole   String    // SUPER_ADMIN, HR_RECRUITER, CLIENT
  note            String?   @db.Text
  createdAt       DateTime  @default(now())
}

model ClientAgreement {
  id                       String    @id @default(uuid())
  agreementNumber          String    @unique // Formatted: RUP-AGR-1001
  clientId                 String
  client                   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adminId                  String
  admin                    User      @relation("AdminAgreements", fields: [adminId], references: [id], onDelete: Cascade)
  placementFeePercent      Float     @default(8.33)
  fixedFeePerHead          Float?
  paymentTermDays          Int       @default(30)
  replacementGuaranteeDays Int       @default(90)
  termsText                String    @db.Text
  hashToken                String    @unique // Secure hash for /agreement/sign/[hashToken]
  status                   String    @default("DRAFT") // DRAFT, SENT, SIGNED, EXPIRED
  signedByName             String?
  signedByDesignation      String?
  signatureImage           String?   @db.Text
  signedAt                 DateTime?
  signerIp                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model ConsultancyBillingConfig {
  id                String   @id @default("RISEUP_BILLING_CONFIG")
  companyName       String   @default("Rise Up Consultancy Pune")
  tagline           String?  @default("Staffing and Recruiting Services")
  address           String   @db.Text
  gstin             String   @default("27ABLFR4477Q1Z4")
  pan               String   @default("ABLFR4477Q")
  hsnSac            String   @default("998512")
  placeOfSupply     String   @default("Pune")
  bankName          String   @default("AU Small Finance Bank")
  bankAccountName   String   @default("Rise Up Consultancy Pune")
  bankAccountNumber String   @default("2502261678246645")
  bankIfsc          String   @default("AUBL0002616")
  termsText         String   @db.Text
  updatedAt         DateTime @updatedAt
}

model TaxSetting {
  id                  String   @id @default(uuid())
  name                String   // e.g. "CGST", "SGST", "IGST"
  rate                Float    // e.g. 9.0, 18.0
  isSelectedByDefault Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model Invoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique // Formatted: RUP-INV-1001
  clientId         String
  client           ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceDate      DateTime      @default(now())
  dueDate          DateTime?
  terms            String        @default("Net 30 Days")
  billingCycle     String?       // e.g., "October 2026 Batch", "Q3 Placement"
  placeOfSupply    String        @default("Pune")

  // Immutable snapshots of Consultancy (Seller) & Client details at generation time
  sellerName          String
  sellerAddress       String    @db.Text
  sellerGstin         String
  sellerPan           String
  sellerHsnSac        String
  sellerBankName      String
  sellerAccountName   String
  sellerAccountNumber String
  sellerIfsc          String
  termsText           String    @db.Text

  clientName          String
  clientAddress       String    @db.Text
  clientGstin         String?
  clientContactPerson String?

  // Financial figures
  subTotal         Float
  taxesJson        String        @db.Text // JSON array of [{ name: "CGST", rate: 9, amount: 157.5 }]
  taxTotal         Float         @default(0)
  tdsDeducted      Float         @default(0)
  grandTotal       Float
  totalInWords     String        @db.Text
  balanceDue       Float

  // Lifecycle
  status           String        @default("SENT") // DRAFT, SENT, PAID, REVISION_REQUESTED
  paymentDate      DateTime?
  paymentReference String?
  clientFeedback   String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  candidates       Candidate[]
  items            InvoiceItem[]
}

model InvoiceItem {
  id            String    @id @default(uuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  candidateId   String?
  srNo          Int
  empId         String?
  candidateName String
  process       String?
  designation   String?
  dateOfJoining DateTime?
  billingAmount Float
}

model SystemCounter {
  id           String @id // "JOB_COUNTER", "CANDIDATE_COUNTER", "AGREEMENT_COUNTER", "HR_COUNTER", "INVOICE_COUNTER", "INQUIRY_COUNTER"
  currentValue Int    @default(1000)
}

model Inquiry {
  id              String   @id @default(uuid())
  inquiryNumber   String   @unique // Formatted: RUP-INQ-1001
  type            String   // TALENT_REQUEST, CANDIDATE_QUERY, EMPLOYER_QUERY, GENERAL
  fullName        String
  companyName     String?
  email           String
  phone           String
  city            String?
  country         String   @default("India")
  subject         String?
  roleRequirement String?  @db.Text // Headcount & role details for talent requests
  message         String?  @db.Text // Message/query text
  source          String   @default("WEBSITE") // HERO_REQUEST_TALENT, CONTACT_PAGE, CONTACT_SECTION
  status          String   @default("NEW") // NEW, IN_PROGRESS, CONNECTED, CONVERTED, CLOSED
  adminNotes      String?  @db.Text
  assignedTo      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
